<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- فقط برای اسکن QR کدهای TOTP/HOTP و اسکن کارت بانکی، و فقط وقتی صفحهٔ اسکن باز است؛ دوربین اجباری نیست. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- نوتیفیکیشن محلی خطا (بدون ارسال داده و بدون متن حساس در اعلان). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ارتباط شبکه کاملاً اختیاری و صرفاً HTTPS (network_security_config):
         فقط در صورت اقدام مستقیم کاربر برای همگام‌سازی WebDAV، اتصال حساب Google/GitHub (OAuth PKCE)
         یا بررسی افشای رمز عبور (k-Anonymity SHA-1 prefix). هیچ ترافیک پس‌زمینهٔ خودکاری وجود ندارد. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- برای بررسی وجود انتخاب‌گر پوشه/فایل و مرورگر در اندروید ۱۱+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
        </intent>
        <intent>
            <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- برای بررسی روت: دیدنِ فقط همین پکیج‌های مدیریت روت (بدون QUERY_ALL_PACKAGES).
         نبودنشان چیزی را ثابت نمی‌کند؛ فقط یک سیگنال هشدار است، نه قفل. -->
    <queries>
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="eu.chainfire.supersu" />
        <package android:name="com.koushikdutta.superuser" />
        <package android:name="me.phh.superuser" />
        <package android:name="com.kingroot.kinguser" />
        <package android:name="com.kingo.root" />
    </queries>

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".RefugeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Refuge"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Refuge.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Links + Passkey: دامنهٔ solina-projects.github.io با assetlinks.json
                 (پکیج app.solina.refuge + اثر انگشت گواهی انتشار) تأیید می‌شود؛
                 فقط روی نصبِ امضاشده با همان گواهی کار می‌کند، نه روی بیلد debug CI. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="solina-projects.github.io"
                    android:scheme="https" />
            </intent-filter>
            <!-- بازگشت امن OAuth 2.0 + PKCE (RFC 8252) برای اتصال اختیاری Google و GitHub -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:path="/callback"
                    android:scheme="refuge-auth" />
            </intent-filter>
        </activity>

        <!-- باز کردن پیوست رمزگشایی‌شده با برنامهٔ مناسب (فاز ۴): فقط کش خصوصی برنامه،
             بدون دسترسی دائمی؛ فایل در شروع اجرای بعد پاک می‌شود. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Autofill: فقط وقتی کاربر Refuge را به‌عنوان سرویس Autofill انتخاب کند فعال می‌شود. -->
        <service
            android:name=".autofill.RefugeAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Refuge"
            android:windowSoftInputMode="adjustResize" />

        <!-- ویجت «یادداشت سریع» (فاز ۳): فقط یک دکمه است، هیچ محتوایی نشان نمی‌دهد. -->
        <receiver
            android:name=".ui.widget.QuickNoteWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_note_widget_info" />
        </receiver>
    </application>
</manifest>
