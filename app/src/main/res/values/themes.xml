<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Refuge" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F7FAFA</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- صفحهٔ لوگوی شروع: گرادیان آیکن (میانگین فیروزه‌ای تا سرمه‌ای) + نمادِ سفیدِ آیکن، هم‌سبک بقیهٔ برنامه‌های Solina -->
    <style name="Theme.Refuge.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#05778A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Refuge</item>
    </style>
</resources>
